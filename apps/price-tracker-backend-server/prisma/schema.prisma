datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TrackedProduct {
  createdAt                 DateTime       @default(now())
  currentPrice              Float?
  desiredDiscountPercentage Float?
  id                        String         @id @default(cuid())
  initialPrice              Float?
  isActive                  Boolean?
  priceHistories            PriceHistory[]
  productUrl                String?
  store                     Store?         @relation(fields: [storeId], references: [id])
  storeId                   String?
  title                     String?
  updatedAt                 DateTime       @updatedAt
  user                      User?          @relation(fields: [userId], references: [id])
  userId                    String?
}

model Store {
  baseUrl         String?
  createdAt       DateTime                 @default(now())
  id              String                   @id @default(cuid())
  isActive        Boolean?
  name            String?
  priceSelector   String?
  scrapingMethod  EnumStoreScrapingMethod?
  titleSelector   String?
  trackedProducts TrackedProduct[]
  updatedAt       DateTime                 @updatedAt
}

model PriceHistory {
  capturedAt       DateTime?
  createdAt        DateTime        @default(now())
  id               String          @id @default(cuid())
  price            Float?
  trackedProduct   TrackedProduct? @relation(fields: [trackedProductId], references: [id])
  trackedProductId String?
  updatedAt        DateTime        @updatedAt
}

model User {
  createdAt       DateTime         @default(now())
  email           String?          @unique
  firstName       String?
  id              String           @id @default(cuid())
  lastName        String?
  password        String
  passwordHash    String?
  roles           Json
  telegramChatId  String?
  trackedProducts TrackedProduct[]
  updatedAt       DateTime         @updatedAt
  username        String           @unique
}

enum EnumStoreScrapingMethod {
  Option1
}
